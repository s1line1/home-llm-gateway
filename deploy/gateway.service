# cloud-gateway systemd 单元（部署在中转云服务器）
# 安装：
#   1. 把二进制放到 /usr/local/bin/gateway
#   2. 把证书与 gateway-config.yml 放到 /etc/home-llm-gateway/
#      （基于 gateway_config.example.yml 修改：证书路径、admin_token、tls、ui_dir 等）
#   3. Web UI（可选）：本机 cd web && pnpm install && pnpm build 后，
#      把 web/dist 整个上传到 /etc/home-llm-gateway/web/，gateway-config.yml 配 ui_dir: web
#      （WorkingDirectory=/etc/home-llm-gateway，相对路径即可；不配 = `/` 显示构建提示页）
#   4. 建日志目录（服务以 root 运行，目录 root 所有即可）：
#      sudo mkdir -p /var/log/home-llm-gateway
#   5. sudo cp deploy/gateway.service /etc/systemd/system/ && sudo systemctl daemon-reload \
#      && sudo systemctl enable --now gateway
[Unit]
Description=Edge LLM Gateway (cloud relay)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 工作目录 = 配置目录：ui_dir / keys.db 等相对路径都以此为准
WorkingDirectory=/etc/home-llm-gateway
# 所有参数都在 /etc/home-llm-gateway/gateway-config.yml 中配置（见 gateway_config.example.yml）
ExecStart=/usr/local/bin/gateway --config /etc/home-llm-gateway/gateway-config.yml
Restart=on-failure
RestartSec=3
# 关闭：Gateway::shutdown 先做一次**有界**的用量落库（`shutdown_flush_secs`，默认 10s），
# 再 abort 所有任务。若要设 TimeoutStopSec，必须 **大于** `shutdown_flush_secs`，
# 否则宽限期还没走完就被 SIGKILL——超时就白设了。
#     TimeoutStopSec=30
# 日志落盘（追加，重启不丢）。stdout/stderr 不再进 journald；
# 查看：tail -f /var/log/home-llm-gateway/gateway.log
# 建议配 logrotate 轮转（见 deploy/logrotate.example 或自行 crontab）。
# 想保留 journald 双写可去掉以下两行（默认回 journald）。
StandardOutput=append:/var/log/home-llm-gateway/gateway.log
StandardError=append:/var/log/home-llm-gateway/gateway.log

# 内存：默认**不设上限**。想让网关超限时只杀自己（而不是触发整机 OOM 把别的进程一起
# 带走），把 MemoryMax 改成具体值，例如 1G（低于实测的 ~1.09GB 死亡水位）：
#     MemoryMax=1G
# ⚠️ 不要把 MemoryHigh 设成小值：网关内存以匿名页为主（实测 99.5%），没有 swap 可回收时
#    MemoryHigh 会让所有 worker 线程卡在 mem_cgroup_handle_over_high 里——进程还活着、
#    systemd 显示 active，但完全不再处理任何请求（实战踩过：500M 直接把服务冻死）。
#    它不触发 Restart=on-failure，因为进程根本没退出。要么留空，要么配合真实可用的 swap。
MemoryHigh=infinity
MemorySwapMax=infinity
OOMPolicy=stop

# 文件描述符：**可以不设**。不设时 systemd 给的是全局默认 soft=1024/hard=524288，
# 而网关启动时会自己把 soft 抬到 min(hard, 16384)（见 gateway/src/nofile.rs、README
# 《文件描述符上限》），所以默认 1024 那个坑已经被代码兜住。
# 只有当你需要**超过 16384 个并发连接**时，才需要在这里抬高天花板（hard），
# 例如： LimitNOFILE=65536
# 注意 `LimitNOFILE=` 会同时设置 soft 与 hard；启动日志里 `limited_by_hard=true`
# 就表示"天花板比目标值低"，即此处需要调整。

[Install]
WantedBy=multi-user.target
