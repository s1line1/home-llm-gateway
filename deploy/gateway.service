# cloud-gateway systemd 单元（部署在中转云服务器）
# 安装：
#   1. 把二进制放到 /usr/local/bin/gateway
#   2. 把证书与 config.yml 放到 /etc/home-llm-gateway/
#      （基于仓库根 config.example.yml 修改：证书路径、api_keys、admin_token、tls 等）
#   3. sudo cp deploy/gateway.service /etc/systemd/system/ && sudo systemctl enable --now gateway
[Unit]
Description=Home LLM Gateway (cloud relay)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 所有参数都在 /etc/home-llm-gateway/config.yml 中配置（见 config.example.yml）
ExecStart=/usr/local/bin/gateway --config /etc/home-llm-gateway/config.yml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
